# Copiá este archivo como .env y completá con los datos de TU proyecto de Supabase
# (supabase.com → tu proyecto → Project Settings → API).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=TU-PROYECTO

# Solo servidor. NUNCA la compartas ni la subas a GitHub.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Solo para cargar la base (migraciones): Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:CONTRASEÑA@db.TU-PROYECTO.supabase.co:5432/postgres
